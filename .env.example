# Usuário Administrador padrão inicial (configure seu email e senha de acesso)
DEFAULT_USER_EMAIL=admin@admin.com
DEFAULT_USER_PASSWORD=admin123

# Sessão do painel (tokens HMAC) — troque por um segredo aleatório longo em produção
SECRET_KEY=change-me

# Criptografia das session_strings do Telegram em repouso (Fernet)
SESSION_SECRET=change-me-too

# Credenciais do app Telegram da PLATAFORMA (my.telegram.org)
TG_API_ID=0
TG_API_HASH=

# Servidor (Em Docker / EasyPanel use HOST=0.0.0.0)
HOST=0.0.0.0
PORT=8000
